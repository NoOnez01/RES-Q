VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_LINE_LOGIN_CHANNEL_ID=
# Optional -- traffic-aware routing via map.longdo.com/console. Falls back
# to OSRM (free, keyless, no live traffic) when unset.
VITE_LONGDO_MAP_KEY=
# Optional -- Google Maps Routes API browser key (restrict it to this app's
# domains and to the Routes API). Billed per route by Google.
VITE_GOOGLE_MAPS_KEY=
# Optional -- routing providers to ask, in order (dstarlite, longdo, google,
# osrm). OSRM always stays last as the free fallback.
VITE_ROUTING_PROVIDERS=
